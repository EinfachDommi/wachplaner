APP_NAME=Wachplaner
APP_ENV=development
APP_DEBUG=true
APP_URL=https://dev.wachplaner.sh-com.de

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

CACHE_DRIVER=file

# Guardian / Wartungsmodus
MAINTENANCE_FORCE=false
MAINTENANCE_MESSAGE="Der Wachplaner wird aktuell gewartet."
MAINTENANCE_RETRY_SECONDS=30
REGISTRATION_ENABLED=true

# Session-Cookies (Produktion: true)
SESSION_SECURE=true
SESSION_SAME_SITE=Lax

